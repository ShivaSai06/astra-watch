[Unit]
Description=Cloudflare Tunnel for monitor.example.com (outbound only)
After=network-online.target
# Does nothing until the one-time tunnel token has been placed on the server.
ConditionPathExists=%h/pi-watcher/config/cloudflared.token

[Service]
Type=simple
ExecStart=%h/pi-watcher/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:8201 run --token-file %h/pi-watcher/config/cloudflared.token
Restart=always
RestartSec=10
Nice=10
MemoryMax=150M
NoNewPrivileges=true

[Install]
WantedBy=default.target
